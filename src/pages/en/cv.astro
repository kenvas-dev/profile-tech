---
/**
 * CV corporativo para imprimir (en, `/en/cv/`). Fuente del PDF generado con `npm run cv:pdf`; no se indexa.
 */
import { getCurriculumUseCase } from "@infrastructure/di/container";
import CvView from "@presentation/views/CvView.astro";

const locale = "en";
const curriculum = await getCurriculumUseCase.execute(locale);
---

<CvView locale={locale} curriculum={curriculum} />
