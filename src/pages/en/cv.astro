---
/**
 * CV para imprimir en inglés (`/en/cv/`). Fuente del PDF generado con `npm run cv:pdf`; no se indexa.
 */
import { getPortfolioUseCase } from "@infrastructure/di/container";
import CvView from "@presentation/views/CvView.astro";

const locale = "en";
const portfolio = await getPortfolioUseCase.execute(locale);
---

<CvView locale={locale} portfolio={portfolio} />
