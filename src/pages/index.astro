---
/**
 * Página principal en español (`/`). Adaptador de entrada: obtiene el contenido mediante el caso de uso y delega el render en `PortfolioView`.
 */
import { getPortfolioUseCase } from "@infrastructure/di/container";
import PortfolioView from "@presentation/views/PortfolioView.astro";

const locale = "es";
const portfolio = await getPortfolioUseCase.execute(locale);
---

<PortfolioView locale={locale} portfolio={portfolio} />
