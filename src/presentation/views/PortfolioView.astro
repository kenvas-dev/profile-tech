---
/**
 * Vista completa del portfolio: compone el layout, el SEO y todas las secciones en orden.
 */
import type { PortfolioOverview } from "@application/use-cases/GetPortfolio";
import type { Locale } from "@domain/entities/locale";
import ContactSection from "../components/sections/ContactSection.astro";
import EducationSection from "../components/sections/EducationSection.astro";
import ExperienceSection from "../components/sections/ExperienceSection.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import ProfileSection from "../components/sections/ProfileSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SkillsSection from "../components/sections/SkillsSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SeoHead from "../components/seo/SeoHead.astro";

interface Props {
	/** Idioma de la página. */
	locale: Locale;
	/** Contenido ya procesado por el caso de uso. */
	portfolio: PortfolioOverview;
}

const { locale, portfolio } = Astro.props;
const { identity, hero } = portfolio;
---

<BaseLayout locale={locale}>
	<SeoHead slot="head" locale={locale} portfolio={portfolio} />
	<HeroSection
		identity={identity}
		navigation={portfolio.navigation}
		hero={hero}
	/>
	<main>
		<ProfileSection sectionIndex="/01" profile={portfolio.profile} />
		<SkillsSection sectionIndex="/02" skills={portfolio.skills} />
		<ExperienceSection
			sectionIndex="/03"
			experience={portfolio.experience}
		/>
		<ProjectsSection sectionIndex="/04" projects={portfolio.projects} />
		<EducationSection sectionIndex="/05" education={portfolio.education} />
		<ContactSection sectionIndex="/06" contact={portfolio.contact} />
	</main>
	<SiteFooter identity={identity} footer={portfolio.footer} />
</BaseLayout>
