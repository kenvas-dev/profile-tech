---
/**
 * CV corporativo en A4, pensado para reclutadores y sistemas ATS: una sola
 * columna, fondo claro, texto real seleccionable y encabezados estándar. La
 * marca se conserva en la tipografía, el monograma y el degradado neón.
 */
import type { Curriculum } from "@domain/entities/curriculum";
import type { Locale } from "@domain/entities/locale";
import CvPosition from "../components/cv/CvPosition.astro";
import CvSection from "../components/cv/CvSection.astro";
import { getUiTranslations } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
	/** Idioma del CV. */
	locale: Locale;
	/** Contenido ya procesado por el caso de uso. */
	curriculum: Curriculum;
}

const { locale, curriculum } = Astro.props;
const {
	identity,
	headline,
	location,
	contacts,
	summary,
	experience,
	skillGroups,
	projects,
	education,
	languages,
	labels,
} = curriculum;
const uiText = getUiTranslations(locale);
---

<BaseLayout locale={locale} isInteractive={false} colorScheme="light">
	<Fragment slot="head">
		<title>{uiText.cv.documentTitle(identity.fullName)}</title>
		<meta name="author" content={identity.fullName} />
		<meta
			name="description"
			content={`${identity.fullName} — ${headline}`}
		/>
		<meta name="robots" content="noindex, follow" />
	</Fragment>

	<article class="c-cv">
		<header class="c-cv__header">
			<div class="c-cv__identity">
				<h1 class="c-cv__name">{identity.fullName}</h1>
				<p class="c-cv__headline">{headline}</p>
			</div>
			<span class="c-cv__brand" aria-hidden="true">
				{identity.brandMark}
			</span>
		</header>

		<address class="c-cv__contact">
			<span class="c-cv__contact-item">{location}</span>
			{contacts.map((contact) => (
				<a class="c-cv__contact-item" href={contact.href}>
					{contact.displayValue}
				</a>
			))}
		</address>

		<CvSection heading={labels.summary}>
			<p class="c-cv__text">{summary}</p>
		</CvSection>

		<CvSection heading={labels.experience}>
			<div class="c-cv__stack">
				{experience.map((position) => (
					<CvPosition
						position={position}
						labels={labels}
						locale={locale}
					/>
				))}
			</div>
		</CvSection>

		<CvSection heading={labels.skills} keepTogether>
			<dl class="c-cv__skills">
				{skillGroups.map((group) => (
					<div class="c-cv__skill-row">
						<dt class="c-cv__skill-title">{group.title}:</dt>
						<dd class="c-cv__skill-list">
							{` ${group.skills.join(", ")}`}
						</dd>
					</div>
				))}
			</dl>
		</CvSection>

		<CvSection heading={labels.projects} keepTogether>
			{projects.map((project) => (
				<div class="c-cv__project">
					<h3 class="c-cv__item-title">
						{project.title}
						<span class="c-cv__item-meta">
							{" — "}
							{project.links.map((link) => (
								<a class="c-cv__inline-link" href={link.href}>
									{link.displayValue}
								</a>
							))}
						</span>
					</h3>
					<p class="c-cv__text">{project.description}</p>
					<p class="c-cv__technologies">
						<span class="c-cv__technologies-label">
							{labels.technologies}:
						</span>{" "}
						{project.technologies.join(", ")}
					</p>
				</div>
			))}
		</CvSection>

		<CvSection heading={labels.education} keepTogether>
			<ul class="c-cv__stack c-cv__stack--tight">
				{education.map((credential) => (
					<li class="c-cv__credential">
						<span class="c-cv__item-title">{credential.title}</span>
						<span class="c-cv__item-meta">
							{" — "}
							{credential.institutionName} ·{" "}
							{credential.completionYear}
						</span>
					</li>
				))}
			</ul>
		</CvSection>

		<CvSection heading={labels.languages} keepTogether>
			<ul class="c-cv__languages">
				{languages.map((language) => (
					<li class="c-cv__language">
						<span class="c-cv__item-title">{language.name}</span>
						<span class="c-cv__item-meta">
							{" — "}
							{language.proficiency}
						</span>
					</li>
				))}
			</ul>
		</CvSection>
	</article>
</BaseLayout>

<style lang="scss">
	@use "abstracts" as *;

	// Márgenes reales de página: el fondo es claro, así que el navegador puede
	// dejarlos en blanco sin franjas, y cada página nueva respira igual.
	$page-margin-block: 10mm;
	$page-margin-inline: 14mm;

	@page {
		size: a4;
		margin: $page-margin-block $page-margin-inline;
	}

	:global(html),
	:global(body) {
		background: paper-token("background");
		color-scheme: light;
		print-color-adjust: exact;
	}

	// Las scanlines CRT del sitio no tienen sentido sobre papel.
	:global(body)::after {
		display: none;
	}

	.c-cv {
		@include flex-column(12px);

		max-width: 210mm;
		margin: 0 auto;
		padding: $page-margin-block $page-margin-inline;
		background: paper-token("background");
		color: paper-token("ink");

		// Ligaduras desactivadas: algunos ATS extraen «fi»/«fl» como un solo
		// glifo ilegible.
		font-variant-ligatures: none;
		print-color-adjust: exact;

		&__header {
			@include flex-row(16px, flex-start, space-between);

			padding-top: 8px;
			border-top: 4px solid transparent;
			border-image: $gradient-neon 1;
		}

		&__identity {
			@include flex-column(4px);
		}

		&__name {
			@include retro-heading(26px, $font-weight-black, 1.1);

			color: paper-token("ink");
		}

		&__headline {
			@include typography("display", 14px, $font-weight-semibold);

			color: paper-token("accent");
		}

		&__brand {
			@include typography("mono", 10px, $font-weight-bold);

			padding: 3px 8px;
			border: 1px solid paper-token("accent");
			border-radius: $radius-sm;
			color: paper-token("accent-alt");
		}

		&__contact {
			@include flex-row(2px 0);
			@include typography("body", 10.5px, $font-weight-regular, 1.5);

			flex-wrap: wrap;
			padding-bottom: 8px;
			border-bottom: 1px solid paper-token("rule");
			color: paper-token("ink-muted");
			font-style: normal;
		}

		&__contact-item {
			color: inherit;

			&:not(:last-child)::after {
				content: "·";
				margin-inline: 8px;
				color: paper-token("accent");
			}
		}

		&__text {
			@include typography("body", 11px, $font-weight-regular, 1.45);

			color: paper-token("ink");
		}

		&__stack {
			@include flex-column(9px);

			&--tight {
				gap: 4px;
			}
		}

		&__skills {
			@include flex-column(3px);
		}

		// Título y lista en la misma línea de texto: el espacio entre ambos es
		// texto real, así los ATS no los pegan («datos:Node.js»).
		&__skill-row {
			@include typography("body", 11px, $font-weight-regular, 1.45);
		}

		&__skill-title {
			display: inline;
			font-family: font-family("display");
			font-weight: $font-weight-bold;
			color: paper-token("ink");
		}

		&__skill-list {
			display: inline;
			color: paper-token("ink-muted");
		}

		&__project {
			@include flex-column(2px);
		}

		&__item-title {
			@include typography("display", 11.5px, $font-weight-bold, 1.4);

			color: paper-token("ink");
		}

		&__item-meta {
			@include typography("body", 10.5px);

			color: paper-token("ink-subtle");
		}

		&__inline-link {
			color: inherit;

			&:not(:last-child)::after {
				content: " ·";
				margin-right: 4px;
			}
		}

		&__technologies {
			@include typography("body", 10.5px, $font-weight-regular, 1.4);

			color: paper-token("ink-muted");
		}

		&__technologies-label {
			font-weight: $font-weight-semibold;
			color: paper-token("accent-alt");
		}

		&__languages {
			@include flex-row(4px 28px);

			flex-wrap: wrap;
		}

		@media print {
			max-width: none;
			padding: 0;
		}
	}
</style>
