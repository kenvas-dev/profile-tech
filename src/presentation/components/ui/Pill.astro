---
/**
 * Etiqueta compacta para tecnologías y estados.
 */
interface Props {
	/** `default` o `accent` (borde y texto turquesa con brillo). */
	variant?: "default" | "accent";
}

const { variant = "default" } = Astro.props;
---

<span class:list={["c-pill", `c-pill--${variant}`]}>
	<slot />
</span>

<style lang="scss">
	@use "abstracts" as *;

	.c-pill {
		@include flex-row;
		@include typography("mono", 11px, $font-weight-medium);

		height: 30px;
		padding-inline: 12px;
		border: 1px solid color-token("border-strong");
		border-radius: $radius-sm;
		background: color-alpha("midnight", 0.5);
		color: color-token("text-muted");
		white-space: nowrap;
		transition:
			border-color $transition-base,
			color $transition-base;

		&:hover {
			border-color: color-token("teal");
			color: color-token("teal");
		}

		&--accent {
			@include neon-box("teal", 0.5);

			border-color: color-token("teal");
			color: color-token("teal");
		}
	}
</style>
