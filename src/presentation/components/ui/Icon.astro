---
/**
 * Icono SVG en línea que hereda el color del texto (`currentColor`).
 */
import { ICONS, type UiIconName } from "./icons";

interface Props {
	/** Nombre del icono en el registro `icons.ts`. */
	iconName: UiIconName;
	/** Ancho y alto en píxeles. */
	size?: number;
	/** Grosor del trazo. */
	strokeWidth?: number;
	/** Clase adicional opcional. */
	class?: string;
}

const {
	iconName,
	size = 16,
	strokeWidth = 1.5,
	class: className,
} = Astro.props;
const { viewBox, paths, circles = [] } = ICONS[iconName];
---

<svg
	class:list={["c-icon", className]}
	width={size}
	height={size}
	viewBox={viewBox}
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{paths.map((pathData) => (
		<path d={pathData} />
	))}
	{circles.map(({ cx, cy, r }) => (
		<circle cx={cx} cy={cy} r={r} />
	))}
</svg>

<style lang="scss">
	.c-icon {
		flex-shrink: 0;
	}
</style>
