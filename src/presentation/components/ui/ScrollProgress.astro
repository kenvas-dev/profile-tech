---
/**
 * Barra de progreso de lectura fija en la parte superior.
 * Un script mínimo (scroll pasivo + requestAnimationFrame) actualiza
 * --scroll-progress. No se usan scroll-driven animations de CSS porque el
 * minificador fusiona animation-timeline en el shorthand y Chrome lo descarta.
 */
---

<div class="c-scroll-progress" aria-hidden="true">
	<div class="c-scroll-progress__bar" data-scroll-progress></div>
</div>

<script>
	import {
		getScrollProgress,
		onScrollFrame,
	} from "../../scripts/onScrollFrame";

	const progressBar = document.querySelector<HTMLElement>(
		"[data-scroll-progress]",
	);

	if (progressBar) {
		onScrollFrame(() => {
			progressBar.style.setProperty(
				"--scroll-progress",
				String(getScrollProgress()),
			);
		});
	}
</script>

<style lang="scss">
	@use "abstracts" as *;

	$bar-height: 3px;

	.c-scroll-progress {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: z-layer("progress");
		height: $bar-height;
		pointer-events: none;
		filter: drop-shadow(0 0 6px color-alpha("magenta", 0.8));

		// El degradado ocupa todo el ancho y se revela: el color avanza con el scroll.
		&__bar {
			height: 100%;
			background: $gradient-neon;
			clip-path: inset(
				0 calc((1 - var(--scroll-progress, 0)) * 100%) 0 0
			);
		}
	}
</style>
