---
/**
 * Barra de progreso de lectura fija en la parte superior.
 * Un script mínimo (scroll pasivo + requestAnimationFrame) actualiza
 * --scroll-progress. No se usan scroll-driven animations de CSS porque el
 * minificador fusiona animation-timeline en el shorthand y Chrome lo descarta.
 */
---

<div class="c-scroll-progress" aria-hidden="true">
	<div class="c-scroll-progress__bar" data-scroll-progress></div>
</div>

<script>
	const bar = document.querySelector<HTMLElement>("[data-scroll-progress]");

	if (bar) {
		let isTicking = false;

		const update = () => {
			const { scrollHeight } = document.documentElement;
			const maxScroll = scrollHeight - window.innerHeight;
			const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;

			bar.style.setProperty(
				"--scroll-progress",
				String(Math.min(1, Math.max(0, progress))),
			);
			isTicking = false;
		};

		const requestUpdate = () => {
			if (isTicking) return;
			isTicking = true;
			requestAnimationFrame(update);
		};

		window.addEventListener("scroll", requestUpdate, { passive: true });
		window.addEventListener("resize", requestUpdate);
		update();
	}
</script>

<style lang="scss">
	@use "abstracts" as *;

	$bar-height: 3px;

	.c-scroll-progress {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: z("progress");
		height: $bar-height;
		pointer-events: none;
		filter: drop-shadow(0 0 6px color-alpha("magenta", 0.8));

		// El degradado ocupa todo el ancho y se revela: el color avanza con el scroll.
		&__bar {
			height: 100%;
			background: $gradient-neon;
			clip-path: inset(
				0 calc((1 - var(--scroll-progress, 0)) * 100%) 0 0
			);
		}
	}
</style>
