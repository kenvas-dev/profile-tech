---
/**
 * Botón flotante «volver arriba». Aparece tras bajar una pantalla; mientras está oculto no es enfocable.
 */
import { getUiTranslationsFor } from "../../i18n/ui";
import Icon from "./Icon.astro";

const uiText = getUiTranslationsFor(Astro.currentLocale);
---

<button
	class="c-back-to-top"
	type="button"
	aria-label={uiText.backToTopLabel}
	title={uiText.backToTopLabel}
	data-back-to-top
>
	<Icon iconName="arrow-up" size={20} strokeWidth={2} />
</button>

<script>
	import { onScrollFrame } from "../../scripts/onScrollFrame";

	const backToTopButton =
		document.querySelector<HTMLButtonElement>("[data-back-to-top]");

	if (backToTopButton) {
		// El scroll suave (o instantáneo con prefers-reduced-motion) lo define
		// `scroll-behavior` en los estilos globales.
		backToTopButton.addEventListener("click", () => {
			window.scrollTo({ top: 0 });
			backToTopButton.blur();
		});

		// Aparece tras bajar más de una pantalla.
		onScrollFrame(() => {
			const hasScrolledPastFirstScreen =
				window.scrollY > window.innerHeight;
			backToTopButton.classList.toggle(
				"c-back-to-top--visible",
				hasScrolledPastFirstScreen,
			);
		});
	}
</script>

<style lang="scss">
	@use "abstracts" as *;

	$size: 48px;
	$offset: 24px;

	.c-back-to-top {
		@include flex-row($justify: center);
		@include neon-box("teal", 0.6);

		position: fixed;
		right: $offset;
		bottom: $offset;
		z-index: z-layer("floating");
		width: $size;
		height: $size;
		padding: 0;
		border: 1px solid color-token("teal");
		border-radius: $radius-sm;
		background: color-token("overlay");
		color: color-token("teal");
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transform: translateY(12px);
		backdrop-filter: blur(6px);
		transition:
			opacity $transition-base,
			visibility $transition-base,
			transform $transition-base,
			box-shadow $transition-base,
			color $transition-base;

		@include respond-below("mobile") {
			right: 16px;
			bottom: 16px;
			width: 44px;
			height: 44px;
		}

		&:hover {
			@include neon-box("magenta", 1);

			border-color: color-token("magenta");
			color: color-token("text");
			transform: translateY(-3px);
		}

		// Oculto también para el teclado (visibility) hasta que se necesita.
		&--visible {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}
	}
</style>
