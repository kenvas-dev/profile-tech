---
/**
 * Cabecera estándar de sección: etiqueta indexada, titular y descripción opcional.
 */
import type { SectionIntro } from "@domain/entities/shared";
import SectionLabel from "./SectionLabel.astro";

interface Props {
	/** Índice visible de la sección (p. ej. `/02`). */
	sectionIndex: string;
	/** Etiqueta, título y descripción. */
	intro: SectionIntro;
	/** `id` del titular, para `aria-labelledby` de la sección. */
	headingId?: string;
}

const { sectionIndex, intro, headingId } = Astro.props;
---

<header class="c-section-header">
	<SectionLabel
		sectionIndex={sectionIndex}
		sectionLabel={intro.sectionLabel}
	/>
	<div class="c-section-header__heading">
		<h2 class="c-section-header__title" id={headingId}>
			{intro.title}
		</h2>
		{intro.description && (
			<p class="c-section-header__description">{intro.description}</p>
		)}
	</div>
</header>

<style lang="scss">
	@use "abstracts" as *;

	.c-section-header {
		@include flex-column(24px);

		&__heading {
			@include flex-row(48px, flex-end, space-between);

			@include respond-below("tablet") {
				flex-direction: column;
				align-items: flex-start;
				gap: 20px;
			}
		}

		&__title {
			@include typography("retro", 40px, $font-weight-bold, 1.15);
			@include neon-text("magenta", 0.6);

			max-width: 720px;
			color: color-token("text");

			@include respond-below("tablet") {
				font-size: 30px;
			}

			@include respond-below("mobile") {
				font-size: 26px;
			}
		}

		&__description {
			@include typography("body", 16px, $font-weight-regular, 1.6);

			flex-shrink: 0;
			width: 390px;
			color: color-token("text-muted");

			@include respond-below("tablet") {
				width: auto;
				max-width: 520px;
			}
		}
	}
</style>
