---
interface Props {
	/** Marca o iniciales que se muestran en el distintivo. */
	mark: string;
	name: string;
	size?: "md" | "sm";
	href?: string;
}

const { mark, name, size = "md", href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class:list={["c-monogram", `c-monogram--${size}`]} href={href}>
	<span class="c-monogram__badge" aria-hidden="true">
		{mark}
	</span>
	<span class="c-monogram__name">{name}</span>
</Tag>

<style lang="scss">
	@use "abstracts" as *;

	.c-monogram {
		@include cluster(12px);

		&__badge {
			@include cluster($justify: center);

			// Monoespaciada: las llaves de la marca {UN1T7D} se leen como código.
			@include typography("mono", 13px, $font-weight-bold);
			@include neon-box("magenta", 0.6);
			@include neon-text("teal", 0.6);

			min-width: 34px;
			height: 34px;
			padding-inline: 10px;
			background: color("midnight");
			letter-spacing: 0.04em;
			white-space: nowrap;
			border: 1px solid color("magenta");
			border-radius: $radius-sm;
			color: color("teal");
		}

		&__name {
			@include typography("retro", 14px, $font-weight-bold);

			letter-spacing: 0.06em;
			color: color("text");
		}

		&--sm &__badge {
			min-width: 32px;
			height: 32px;
			padding-inline: 8px;
			font-size: 11px;
		}
	}
</style>
