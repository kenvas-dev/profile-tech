---
/**
 * Lista de pills.
 */
import Pill from "./Pill.astro";

interface Props {
	/** Textos de cada pill. */
	items: readonly string[];
	/** Si las pills pueden pasar a varias líneas. */
	shouldWrap?: boolean;
}

const { items, shouldWrap = true } = Astro.props;
---

<ul class:list={["c-pill-list", { "c-pill-list--nowrap": !shouldWrap }]}>
	{items.map((item) => (
		<li>
			<Pill>{item}</Pill>
		</li>
	))}
</ul>

<style lang="scss">
	@use "abstracts" as *;

	.c-pill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;

		&--nowrap {
			flex-wrap: nowrap;
		}
	}
</style>
