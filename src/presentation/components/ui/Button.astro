---
/**
 * Enlace con apariencia de botón.
 */
import Icon from "./Icon.astro";
import type { UiIconName } from "./icons";

interface Props {
	/** Destino del enlace. */
	href: string;
	/** `primary` (relleno con degradado) o `ghost` (solo borde). */
	variant?: "primary" | "ghost";
	/** Icono opcional tras el texto. */
	iconName?: UiIconName;
}

const { href, variant = "primary", iconName } = Astro.props;
---

<a class:list={["c-button", `c-button--${variant}`]} href={href}>
	<slot />
	{iconName && <Icon iconName={iconName} strokeWidth={1.7} />}
</a>

<style lang="scss">
	@use "abstracts" as *;

	.c-button {
		@include flex-row(12px);
		@include typography("mono", 13px, $font-weight-semibold);

		height: 52px;
		padding-inline: 22px;
		border: 1px solid transparent;
		border-radius: $radius-sm;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition:
			transform $transition-base,
			box-shadow $transition-base,
			border-color $transition-base;

		&:hover {
			transform: translateY(-2px);
		}

		&--primary {
			@include neon-box("magenta", 0.6);

			background: linear-gradient(
				90deg,
				color-token("magenta"),
				color-token("salmon")
			);
			color: color-token("text");

			&:hover {
				@include neon-box("magenta", 1.2);
			}
		}

		&--ghost {
			border-color: color-token("teal");
			color: color-token("teal");

			&:hover {
				@include neon-box("teal");
			}
		}
	}
</style>
