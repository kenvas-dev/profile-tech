---
import type { ProjectKind } from "@domain/entities/projects";

interface Props {
	kind: ProjectKind;
	/** Descripción accesible de la ilustración. */
	label: string;
}

const { kind, label } = Astro.props;

// Ventana de navegador común: 520×300 dentro de un lienzo de 600×360.
const win = { x: 40, y: 30, w: 520, h: 300, bar: 28 };
const content = { x: win.x, y: win.y + win.bar, w: win.w, h: win.h - win.bar };

const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const palette = ["teal", "magenta", "salmon", "plum", "steel"] as const;
---

<div class="c-project-illustration">
	<svg
		class="c-project-illustration__svg"
		viewBox="0 0 600 360"
		preserveAspectRatio="xMidYMid meet"
		role="img"
		aria-label={label}
	>
		<!-- Ventana -->
		<rect
			class="c-project-illustration__window"
			x={win.x}
			y={win.y}
			width={win.w}
			height={win.h}
			rx="10"
		/>
		<path
			class="c-project-illustration__bar"
			d={`M${win.x} ${win.y + 10} a10 10 0 0 1 10 -10 h${win.w - 20} a10 10 0 0 1 10 10 v${win.bar - 10} h-${win.w} z`}
		/>
		<circle
			class="c-project-illustration__fill c-project-illustration__fill--magenta"
			cx="58"
			cy="44"
			r="4"
		/>
		<circle
			class="c-project-illustration__fill c-project-illustration__fill--salmon"
			cx="72"
			cy="44"
			r="4"
		/>
		<circle
			class="c-project-illustration__fill c-project-illustration__fill--teal"
			cx="86"
			cy="44"
			r="4"
		/>
		<rect
			class="c-project-illustration__line"
			x="110"
			y="38"
			width="200"
			height="12"
			rx="6"
		/>

		{kind === "crm" && (
			<g>
				{/* Menú lateral */}
				<rect
					class="c-project-illustration__panel"
					x={content.x}
					y={content.y}
					width="96"
					height={content.h}
				/>
				{range(6).map((i) => (
					<rect
						class:list={[
							"c-project-illustration__fill",
							i === 1
								? "c-project-illustration__fill--teal"
								: "c-project-illustration__fill--soft",
						]}
						x="56"
						y={80 + i * 30}
						width={i === 1 ? 64 : 52}
						height="10"
						rx="5"
					/>
				))}
				{/* KPIs */}
				{(["magenta", "teal", "salmon"] as const).map((tone, i) => (
					<g>
						<rect
							class="c-project-illustration__card"
							x={152 + i * 134}
							y="74"
							width="122"
							height="62"
							rx="8"
						/>
						<rect
							class="c-project-illustration__line"
							x={166 + i * 134}
							y="88"
							width="54"
							height="8"
							rx="4"
						/>
						<rect
							class:list={[
								"c-project-illustration__fill",
								`c-project-illustration__fill--${tone}`,
							]}
							x={166 + i * 134}
							y="106"
							width={60 + i * 10}
							height="16"
							rx="4"
						/>
					</g>
				))}
				{/* Gráfico de gestiones */}
				<rect
					class="c-project-illustration__card"
					x="152"
					y="150"
					width="256"
					height="164"
					rx="8"
				/>
				{range(7).map((i) => (
					<rect
						class="c-project-illustration__fill c-project-illustration__fill--plum"
						x={172 + i * 32}
						y={290 - [50, 80, 64, 104, 90, 122, 110][i]}
						width="18"
						height={[50, 80, 64, 104, 90, 122, 110][i]}
						rx="3"
					/>
				))}
				<polyline
					class="c-project-illustration__stroke c-project-illustration__stroke--teal"
					points="181,232 213,206 245,218 277,180 309,192 341,160 373,170"
				/>
				{/* Ficha de cliente */}
				<rect
					class="c-project-illustration__card"
					x="420"
					y="150"
					width="124"
					height="164"
					rx="8"
				/>
				<circle
					class="c-project-illustration__stroke c-project-illustration__stroke--magenta"
					cx="482"
					cy="192"
					r="20"
				/>
				<rect
					class="c-project-illustration__line"
					x="446"
					y="226"
					width="72"
					height="9"
					rx="4.5"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--soft"
					x="452"
					y="243"
					width="60"
					height="7"
					rx="3.5"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--teal"
					x="440"
					y="272"
					width="84"
					height="22"
					rx="6"
				/>
			</g>
		)}

		{kind === "real-estate" && (
			<g>
				{/* Mapa */}
				<rect
					class="c-project-illustration__panel"
					x={content.x}
					y={content.y}
					width="372"
					height={content.h}
				/>
				{[
					"M40 120 L412 210",
					"M40 260 L412 150",
					"M150 58 L230 330",
					"M320 58 L280 330",
				].map((d) => (
					<path class="c-project-illustration__street" d={d} />
				))}
				{[
					"70,70 140,86 126,128 58,112",
					"250,74 312,64 318,118 262,128",
					"72,282 138,262 150,318 84,326",
					"300,250 390,226 398,300 316,318",
					"168,150 236,166 222,214 160,200",
				].map((points) => (
					<polygon
						class="c-project-illustration__parcel"
						points={points}
					/>
				))}
				{(
					[
						[100, 108, "magenta"],
						[286, 104, "teal"],
						[196, 192, "salmon"],
						[352, 280, "magenta"],
						[110, 300, "teal"],
					] as const
				).map(([x, y, tone]) => (
					<g transform={`translate(${x} ${y})`}>
						<path
							class:list={[
								"c-project-illustration__pin",
								`c-project-illustration__fill--${tone}`,
							]}
							d="M0 0 L-8 -13 A9.5 9.5 0 1 1 8 -13 Z"
						/>
						<circle
							class="c-project-illustration__fill c-project-illustration__fill--dark"
							cx="0"
							cy="-19"
							r="3.5"
						/>
					</g>
				))}
				{/* Listado de inmuebles */}
				{range(3).map((i) => (
					<g>
						<rect
							class="c-project-illustration__card"
							x="426"
							y={72 + i * 84}
							width="120"
							height="72"
							rx="8"
						/>
						<rect
							class:list={[
								"c-project-illustration__fill",
								`c-project-illustration__fill--${palette[i]}`,
							]}
							x="436"
							y={82 + i * 84}
							width="34"
							height="34"
							rx="6"
						/>
						<rect
							class="c-project-illustration__line"
							x="478"
							y={86 + i * 84}
							width="56"
							height="8"
							rx="4"
						/>
						<rect
							class="c-project-illustration__fill c-project-illustration__fill--soft"
							x="478"
							y={102 + i * 84}
							width="40"
							height="7"
							rx="3.5"
						/>
						<rect
							class="c-project-illustration__fill c-project-illustration__fill--teal"
							x="436"
							y={124 + i * 84}
							width="60"
							height="8"
							rx="4"
						/>
					</g>
				))}
			</g>
		)}

		{kind === "rentals" && (
			<g>
				{/* Calendario de reservas */}
				<rect
					class="c-project-illustration__line"
					x="62"
					y="72"
					width="120"
					height="12"
					rx="6"
				/>
				{range(35).map((i) => {
					const col = i % 7;
					const row = Math.floor(i / 7);
					const booked = [3, 4, 5, 11, 12, 22, 23, 24, 25].includes(
						i,
					);
					const pending = [16, 17, 30, 31].includes(i);
					return (
						<rect
							class:list={[
								"c-project-illustration__fill",
								booked &&
									"c-project-illustration__fill--magenta",
								pending && "c-project-illustration__fill--teal",
								!booked &&
									!pending &&
									"c-project-illustration__fill--soft",
							]}
							x={62 + col * 46}
							y={98 + row * 46}
							width="38"
							height="38"
							rx="6"
							opacity={booked || pending ? 0.85 : 0.6}
						/>
					);
				})}
				{/* Ficha de propiedad */}
				<rect
					class="c-project-illustration__card"
					x="404"
					y="72"
					width="140"
					height="242"
					rx="10"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--plum"
					x="416"
					y="84"
					width="116"
					height="82"
					rx="6"
				/>
				<path
					class="c-project-illustration__stroke c-project-illustration__stroke--salmon"
					d="M440 150 L474 112 L508 150 Z"
				/>
				<rect
					class="c-project-illustration__line"
					x="416"
					y="180"
					width="96"
					height="10"
					rx="5"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--soft"
					x="416"
					y="198"
					width="70"
					height="8"
					rx="4"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--salmon"
					x="416"
					y="224"
					width="54"
					height="16"
					rx="4"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--teal"
					x="416"
					y="276"
					width="116"
					height="24"
					rx="6"
				/>
			</g>
		)}

		{kind === "admin-panel" && (
			<g>
				{/* Paleta de colores */}
				{palette.map((tone, i) => (
					<rect
						class:list={[
							"c-project-illustration__fill",
							`c-project-illustration__fill--${tone}`,
						]}
						x={60 + i * 62}
						y="74"
						width="52"
						height="36"
						rx="6"
					/>
				))}
				{/* Tabla del panel administrativo */}
				<rect
					class="c-project-illustration__card"
					x="60"
					y="124"
					width="300"
					height="190"
					rx="8"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--plum"
					x="60"
					y="124"
					width="300"
					height="26"
					rx="8"
				/>
				{range(5).map((i) => (
					<g>
						<circle
							class:list={[
								"c-project-illustration__fill",
								`c-project-illustration__fill--${palette[i]}`,
							]}
							cx="82"
							cy={170 + i * 30}
							r="8"
						/>
						<rect
							class="c-project-illustration__line"
							x="100"
							y={166 + i * 30}
							width="110"
							height="8"
							rx="4"
						/>
						<rect
							class="c-project-illustration__fill c-project-illustration__fill--soft"
							x="230"
							y={166 + i * 30}
							width="56"
							height="8"
							rx="4"
						/>
						<rect
							class="c-project-illustration__fill c-project-illustration__fill--teal"
							x="306"
							y={164 + i * 30}
							width="38"
							height="12"
							rx="6"
						/>
					</g>
				))}
				{/* App móvil */}
				<rect
					class="c-project-illustration__phone"
					x="408"
					y="62"
					width="124"
					height="252"
					rx="18"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--dark"
					x="448"
					y="70"
					width="44"
					height="8"
					rx="4"
				/>
				{range(6).map((i) => (
					<rect
						class:list={[
							"c-project-illustration__fill",
							`c-project-illustration__fill--${palette[(i + 1) % palette.length]}`,
						]}
						x={422 + (i % 2) * 52}
						y={94 + Math.floor(i / 2) * 58}
						width="44"
						height="48"
						rx="8"
					/>
				))}
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--salmon"
					x="422"
					y="274"
					width="96"
					height="22"
					rx="11"
				/>
			</g>
		)}

		{kind === "websites" && (
			<g>
				{/* Galería de fotografía */}
				{range(6).map((i) => (
					<rect
						class:list={[
							"c-project-illustration__fill",
							`c-project-illustration__fill--${palette[i % palette.length]}`,
						]}
						x={60 + (i % 3) * 78}
						y={74 + Math.floor(i / 3) * 78}
						width="70"
						height="70"
						rx="6"
						opacity={0.55 + (i % 3) * 0.15}
					/>
				))}
				{/* Blog */}
				{range(4).map((i) => (
					<g>
						<rect
							class="c-project-illustration__line"
							x="60"
							y={244 + i * 18}
							width={[210, 180, 200, 140][i]}
							height="8"
							rx="4"
						/>
					</g>
				))}
				{/* Landing page con sol retro */}
				<rect
					class="c-project-illustration__card"
					x="312"
					y="74"
					width="232"
					height="240"
					rx="10"
				/>
				<circle
					class="c-project-illustration__sun"
					cx="428"
					cy="150"
					r="46"
				/>
				{range(4).map((i) => (
					<rect
						class="c-project-illustration__panel"
						x="380"
						y={156 + i * 10}
						width="96"
						height={2 + i}
					/>
				))}
				<rect
					class="c-project-illustration__line"
					x="340"
					y="214"
					width="176"
					height="12"
					rx="6"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--soft"
					x="360"
					y="236"
					width="136"
					height="8"
					rx="4"
				/>
				<rect
					class="c-project-illustration__fill c-project-illustration__fill--magenta"
					x="382"
					y="266"
					width="92"
					height="24"
					rx="6"
				/>
			</g>
		)}
	</svg>
</div>

<style lang="scss">
	@use "abstracts" as *;

	$grid-cell: 32px;

	.c-project-illustration {
		position: absolute;
		inset: 0;
		z-index: z("decoration");
		background:
			linear-gradient(color-alpha("teal", 0.08) 1px, transparent 1px),
			linear-gradient(
				90deg,
				color-alpha("teal", 0.08) 1px,
				transparent 1px
			),
			radial-gradient(
				circle at 50% 120%,
				color-alpha("magenta", 0.35),
				transparent 60%
			),
			color("background");
		background-size:
			$grid-cell $grid-cell,
			$grid-cell $grid-cell,
			100% 100%,
			100% 100%;

		&__svg {
			width: 100%;
			height: 100%;
			padding: 12px;
		}

		&__window {
			fill: color("surface");
			stroke: color("teal");
			stroke-width: 1.5;
			filter: drop-shadow(0 0 8px color-alpha("teal", 0.45));
		}

		&__bar {
			fill: color("midnight");
		}

		&__panel {
			fill: color("background");
		}

		&__card {
			fill: color-alpha("midnight", 0.9);
			stroke: color("border-strong");
			stroke-width: 1;
		}

		&__phone {
			fill: color("background");
			stroke: color("salmon");
			stroke-width: 2;
			filter: drop-shadow(0 0 8px color-alpha("salmon", 0.5));
		}

		&__line {
			fill: color("border-strong");
		}

		&__street {
			fill: none;
			stroke: color("border");
			stroke-width: 8;
			stroke-linecap: round;
		}

		&__parcel {
			fill: color-alpha("plum", 0.35);
			stroke: color("plum");
			stroke-width: 1.5;
		}

		&__pin {
			filter: drop-shadow(0 0 6px currentcolor);
		}

		&__sun {
			fill: color("salmon");
			filter: drop-shadow(0 0 14px color-alpha("magenta", 0.7));
		}

		&__stroke {
			fill: none;
			stroke-width: 3;
			stroke-linecap: round;
			stroke-linejoin: round;

			&--teal {
				stroke: color("teal");
				filter: drop-shadow(0 0 5px color-alpha("teal", 0.8));
			}

			&--magenta {
				stroke: color("magenta");
			}

			&--salmon {
				stroke: color("salmon");
			}
		}

		&__fill {
			&--teal {
				color: color("teal");
				fill: color("teal");
			}

			&--magenta {
				color: color("magenta");
				fill: color("magenta");
			}

			&--salmon {
				color: color("salmon");
				fill: color("salmon");
			}

			&--plum {
				fill: color("plum");
			}

			&--steel {
				fill: color("steel");
			}

			&--soft {
				fill: color("border");
			}

			&--dark {
				fill: color("background");
			}
		}
	}
</style>
