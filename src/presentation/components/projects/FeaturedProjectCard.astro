---
/**
 * Tarjeta grande del proyecto destacado: vista previa (foto o ilustración), descripción, stack y resultados.
 */
import type { Project } from "@domain/entities/projects";
import { getUiTranslationsFor } from "../../i18n/ui";
import Icon from "../ui/Icon.astro";
import PillList from "../ui/PillList.astro";
import ProjectIllustration from "./ProjectIllustration.astro";
import ProjectResult from "./ProjectResult.astro";

interface Props {
	/** Proyecto a mostrar. */
	project: Project;
}

const { project } = Astro.props;
const uiText = getUiTranslationsFor(Astro.currentLocale);
---

<article class="c-featured-project">
	<div
		class:list={[
			"c-featured-project__preview",
			{ "c-featured-project__preview--photo": project.preview },
		]}
	>
		{project.preview ? (
			<img
				class="c-featured-project__image"
				src={project.preview.src}
				alt={project.preview.alt}
				width="650"
				height="480"
				loading="lazy"
			/>
		) : (
			<ProjectIllustration
				productKind={project.productKind}
				accessibleLabel={uiText.projectIllustrationAlt(project.title)}
			/>
		)}
		<span class="c-featured-project__badge">
			<span
				class="c-featured-project__badge-dot"
				aria-hidden="true"
			></span>
			{project.caseStudyCode}
		</span>
	</div>

	<div class="c-featured-project__content">
		<div class="c-featured-project__description">
			<p class="c-featured-project__category">{project.category}</p>
			<h3 class="c-featured-project__title">{project.title}</h3>
			<p class="c-featured-project__summary">{project.summary}</p>
			<PillList items={project.technologies} />
		</div>

		<footer class="c-featured-project__impact">
			{project.results.map((result) => (
				<ProjectResult result={result} />
			))}
			{project.link && (
				<a class="c-featured-project__link" href={project.link.href}>
					{project.link.label}
					<span class="c-featured-project__link-icon">
						<Icon iconName="arrow-up-right" strokeWidth={1.7} />
					</span>
				</a>
			)}
		</footer>
	</div>
</article>

<style lang="scss">
	@use "abstracts" as *;

	.c-featured-project {
		@include surface($border: "teal", $radius: $radius-lg);
		@include neon-box("teal", 0.6);

		display: flex;
		min-height: 480px;
		overflow: hidden;

		@include respond-below("tablet") {
			flex-direction: column;
		}

		&__preview {
			position: relative;
			flex: 0 0 51%; // 650px de 1280px en el diseño original
			padding: 32px;

			@include respond-below("laptop") {
				flex-basis: 45%;
			}

			@include respond-below("tablet") {
				flex-basis: auto;
				aspect-ratio: 650 / 480;
			}

			&--photo::after {
				@include synthwave-tint;
			}
		}

		&__image {
			@include cover-image;
		}

		&__badge {
			@include overlay-badge;

			position: relative;
			display: inline-flex;
			z-index: z-layer("content");
			padding: 8px 12px;
			color: color-token("teal");
		}

		&__badge-dot {
			width: 7px;
			height: 7px;
			border-radius: $radius-pill;
			background: color-token("teal");
			box-shadow: 0 0 8px color-token("teal");
		}

		&__content {
			@include flex-column(48px);

			justify-content: space-between;
			flex: 1;
			min-width: 0;
			padding: 48px;

			@include respond-below("laptop") {
				padding: 32px;
			}

			@include respond-below("mobile") {
				padding: 24px;
			}
		}

		&__description {
			@include flex-column(24px, flex-start);
		}

		&__category {
			@include flex-row(12px);
			@include mono-label(12px, "magenta");

			&::after {
				content: "";
				width: 48px;
				height: 1px;
				background: color-token("border-strong");
			}
		}

		&__title {
			@include typography("retro", 34px, $font-weight-bold, 1.12);
			@include gradient-text(
				linear-gradient(
					90deg,
					color-token("salmon"),
					color-token("magenta")
				)
			);

			@include respond-below("mobile") {
				font-size: 30px;
			}
		}

		&__summary {
			@include typography("body", 16px, $font-weight-regular, 1.7);

			color: color-token("text-muted");
		}

		&__impact {
			@include flex-row(48px, flex-start);
			@include divider(top);

			flex-wrap: wrap;
			padding-top: 24px;

			@include respond-below("mobile") {
				gap: 24px;
			}
		}

		&__link {
			@include flex-row(8px);
			@include typography("body", 14px);

			color: color-token("text");
			transition: color $transition-base;

			&:hover {
				color: color-token("teal");
			}
		}

		&__link-icon {
			color: color-token("teal");
		}
	}
</style>
