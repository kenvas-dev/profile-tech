---
/**
 * Tarjeta compacta de proyecto para la rejilla. El tono de acento del dominio se traduce aquí a un color de la paleta.
 */
import type { Project } from "@domain/entities/projects";
import { getUiTranslationsFor } from "../../i18n/ui";
import Icon from "../ui/Icon.astro";
import PillList from "../ui/PillList.astro";
import ProjectIllustration from "./ProjectIllustration.astro";
import ProjectResult from "./ProjectResult.astro";

interface Props {
	/** Proyecto a mostrar. */
	project: Project;
}

const { project } = Astro.props;
const uiText = getUiTranslationsFor(Astro.currentLocale);
---

<article
	class:list={["c-project-card", `c-project-card--${project.accentTone}`]}
>
	<div
		class:list={[
			"c-project-card__preview",
			{ "c-project-card__preview--photo": project.preview },
		]}
	>
		{project.preview ? (
			<img
				class="c-project-card__image"
				src={project.preview.src}
				alt={project.preview.alt}
				width="624"
				height="250"
				loading="lazy"
			/>
		) : (
			<ProjectIllustration
				productKind={project.productKind}
				accessibleLabel={uiText.projectIllustrationAlt(project.title)}
			/>
		)}
		<span class="c-project-card__badge">{project.caseStudyCode}</span>
	</div>

	<div class="c-project-card__content">
		<header class="c-project-card__header">
			<div class="c-project-card__name">
				<p class="c-project-card__category">{project.category}</p>
				<h3 class="c-project-card__title">
					{project.link ? (
						<a
							class="c-project-card__link"
							href={project.link.href}
						>
							{project.title}
						</a>
					) : (
						project.title
					)}
				</h3>
			</div>
			{project.link && (
				<span class="c-project-card__arrow">
					<Icon iconName="arrow-up-right" size={22} />
				</span>
			)}
		</header>

		<p class="c-project-card__summary">{project.summary}</p>

		<footer class="c-project-card__footer">
			{project.results.map((result) => (
				<ProjectResult result={result} />
			))}
			<PillList items={project.technologies} />
		</footer>
	</div>
</article>

<style lang="scss">
	@use "abstracts" as *;

	// Tono semántico del dominio → color de la paleta.
	$tones: (
		"primary": "teal",
		"secondary": "magenta",
		"tertiary": "salmon",
	);

	.c-project-card {
		@include surface;
		@include flex-column;

		position: relative;
		height: 100%;
		min-height: 515px;
		overflow: hidden;
		transition:
			border-color $transition-base,
			box-shadow $transition-base,
			transform $transition-base;

		&:hover {
			border-color: var(--project-tone);
			box-shadow:
				0 0 8px var(--project-tone),
				0 0 28px color-alpha("magenta", 0.25);
			transform: translateY(-4px);
		}

		@each $tone, $color-name in $tones {
			&--#{$tone} {
				--project-tone: #{color-token($color-name)};
			}
		}

		&__preview {
			position: relative;
			height: 250px;
			padding: 24px;

			&--photo::after {
				@include synthwave-tint;
			}
		}

		&__image {
			@include cover-image;
		}

		&__badge {
			@include overlay-badge;

			position: relative;
			z-index: z-layer("content");
			display: inline-flex;
			color: var(--project-tone);
		}

		&__content {
			@include flex-column(16px);

			padding: 24px;
		}

		&__header {
			@include flex-row(16px, flex-start, space-between);
		}

		&__name {
			@include flex-column(8px);
		}

		&__category {
			@include mono-label(12px);

			color: var(--project-tone);
		}

		&__title {
			@include typography("display", 28px, $font-weight-bold);

			color: color-token("text");
		}

		// Toda la tarjeta es clicable manteniendo un único enlace accesible.
		&__link::after {
			content: "";
			position: absolute;
			inset: 0;
		}

		&__arrow {
			color: color-token("text-muted");
			transition: color $transition-base;
		}

		&:hover &__arrow {
			color: color-token("teal");
		}

		&__summary {
			@include typography("body", 14px, $font-weight-regular, 1.55);

			color: color-token("text-muted");
		}

		&__footer {
			@include flex-row(16px, flex-end, space-between);

			flex-wrap: wrap;
		}
	}
</style>
