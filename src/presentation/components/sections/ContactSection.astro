---
/**
 * Sección de contacto: invitación, correo, canales y la mini sección «hecho con Astro».
 */
import type { Contact } from "@domain/entities/contact";
import { getUiTranslationsFor } from "../../i18n/ui";
import BuiltWith from "../contact/BuiltWith.astro";
import Icon from "../ui/Icon.astro";
import RetroSun from "../ui/RetroSun.astro";
import SectionLabel from "../ui/SectionLabel.astro";
import StatusDot from "../ui/StatusDot.astro";
import SynthGrid from "../ui/SynthGrid.astro";

interface Props {
	/** Índice visible de la sección. */
	sectionIndex: string;
	/** Contenido de contacto. */
	contact: Contact;
}

const { sectionIndex, contact } = Astro.props;
const uiText = getUiTranslationsFor(Astro.currentLocale);
---

<section
	class="l-section c-contact"
	id="contacto"
	aria-labelledby="contacto-title"
>
	<div class="c-contact__sun">
		<RetroSun size={360} />
	</div>
	<SynthGrid heightInPixels={220} />

	<div class="l-container c-contact__content">
		<SectionLabel
			sectionIndex={sectionIndex}
			sectionLabel={contact.sectionLabel}
		/>

		<div class="c-contact__invitation">
			<div class="c-contact__message">
				<h2 class="c-contact__title" id="contacto-title">
					{contact.title}
				</h2>
				<p class="c-contact__description">{contact.description}</p>
				<a class="c-contact__email" href={`mailto:${contact.email}`}>
					{contact.email}
					<Icon
						iconName="arrow-up-right"
						size={25}
						strokeWidth={1.8}
					/>
				</a>
			</div>

			<div class="c-contact__aside">
				<aside
					class="c-channels"
					aria-label={uiText.contactChannelsLabel}
				>
					<p class="c-channels__status">
						<StatusDot />
						{contact.availabilityStatus}
					</p>
					<ul>
						{contact.channels.map((channel) => (
							<li>
								<a
									class="c-channel"
									href={channel.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="c-channel__icon">
										<Icon
											iconName={channel.iconName}
											size={18}
										/>
									</span>
									<span class="c-channel__label">
										{channel.platformLabel}
									</span>
									<span class="c-channel__value">
										{channel.displayValue}
									</span>
									<span class="c-channel__arrow">
										<Icon iconName="arrow-up-right" />
									</span>
								</a>
							</li>
						))}
					</ul>
				</aside>
			</div>
		</div>

		<BuiltWith builtWith={contact.builtWith} />
	</div>
</section>

<style lang="scss">
	@use "abstracts" as *;

	.c-contact {
		overflow: hidden;
		min-height: 610px;
		padding-block: 88px 260px;
		background: $gradient-sky;

		&__content {
			z-index: z-layer("content");
		}

		&__sun {
			position: absolute;
			bottom: 150px;
			left: 58%;
			opacity: 0.9;
			transform: translateX(-50%);

			@include respond-below("laptop") {
				left: 50%;
			}
		}

		&__invitation {
			@include flex-row(72px, flex-start);

			@include respond-below("laptop") {
				flex-direction: column;
				align-items: stretch;
				gap: 48px;
			}
		}

		&__aside {
			@include flex-column(24px);

			flex-shrink: 0;
			width: 400px;

			@include respond-below("laptop") {
				width: 100%;
			}
		}

		&__message {
			@include flex-column(24px, flex-start);

			flex: 1;
			min-width: 0;
		}

		&__title {
			@include typography("retro", 56px, $font-weight-bold, 1.1);
			@include neon-text("magenta", 0.8);

			color: color-token("text");

			@include respond-below("mobile") {
				font-size: 32px;
			}
		}

		&__description {
			@include typography("body", 18px, $font-weight-regular, 1.65);

			max-width: 680px;
			color: color-token("text-muted");
		}

		&__email {
			@include flex-row(16px);
			@include typography("display", 32px, $font-weight-bold);
			@include neon-text("teal", 0.7);

			max-width: 100%;
			padding-bottom: 8px;
			border-bottom: 2px solid color-token("teal");
			color: color-token("teal");
			box-shadow: 0 6px 10px -6px color-token("teal");
			overflow-wrap: anywhere;
			transition: gap $transition-base;

			@include respond-below("mobile") {
				font-size: 22px;
			}

			&:hover {
				gap: 24px;
			}
		}
	}

	.c-channels {
		@include surface($background: "overlay", $border: "teal");
		@include flex-column(24px);
		@include neon-box("teal", 0.5);

		backdrop-filter: blur(6px);
		padding: 32px;

		@include respond-below("mobile") {
			padding: 24px;
		}

		&__status {
			@include flex-row(12px);
			@include mono-label(12px, "teal");
		}
	}

	.c-channel {
		@include flex-row(16px);
		@include divider(bottom);

		padding-block: 16px;

		&__icon {
			color: color-token("teal");
		}

		&__label {
			@include mono-label(12px);

			flex-shrink: 0;
			width: 100px;
		}

		&__value {
			@include typography("body", 14px);

			flex: 1;
			min-width: 0;
			color: color-token("text");
		}

		&__arrow {
			color: color-token("text-subtle");
			transition: color $transition-base;
		}

		&:hover &__arrow {
			color: color-token("teal");
		}
	}
</style>
