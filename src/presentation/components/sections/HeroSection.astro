---
/**
 * Cabecera principal: navegación, presentación, llamadas a la acción y retrato sobre el escenario synthwave (estrellas, sol y rejilla).
 */
import type { NavigationLink } from "@domain/entities/contact";
import type { Hero, Identity } from "@domain/entities/identity";
import HeroPortrait from "../hero/HeroPortrait.astro";
import Button from "../ui/Button.astro";
import StatusDot from "../ui/StatusDot.astro";
import SynthGrid from "../ui/SynthGrid.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
	/** Datos de la persona. */
	identity: Identity;
	/** Enlaces de la navegación principal. */
	navigation: readonly NavigationLink[];
	/** Contenido de la cabecera. */
	hero: Hero;
}

const { identity, navigation, hero } = Astro.props;
---

<section class="c-hero" id="inicio" aria-labelledby="hero-title">
	<div class="c-hero__inner">
		<SiteHeader identity={identity} navigation={navigation} />

		<div class="c-hero__presentation">
			<div class="c-hero__message">
				<p class="c-hero__availability">
					<StatusDot hasGlow />
					{hero.availabilityStatus}
				</p>

				<div class="c-hero__headline">
					<p class="c-hero__context">{hero.tagline}</p>
					<h1 class="c-hero__name" id="hero-title">
						{identity.fullName.toUpperCase()}
					</h1>
					<p class="c-hero__role">
						{hero.headline.primaryRole}{" "}
						<span class="c-hero__role-accent">+</span>{" "}
						{hero.headline.secondaryRole}
					</p>
				</div>

				<p class="c-hero__value">{hero.valueProposition}</p>

				<div class="c-hero__actions">
					<Button
						href={hero.primaryAction.href}
						iconName="arrow-down-right"
					>
						{hero.primaryAction.label}
					</Button>
					<Button
						href={hero.secondaryAction.href}
						variant="ghost"
						iconName="send"
					>
						{hero.secondaryAction.label}
					</Button>
				</div>

				<ul class="c-hero__links">
					{hero.professionalLinks.map((link) => (
						<li>
							<a
								class="c-hero__link"
								href={link.href}
								download={
									link.href.endsWith(".pdf") ? "" : undefined
								}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div class="c-hero__visual">
				<HeroPortrait portrait={hero.portrait} />
			</div>
		</div>
	</div>

	<SynthGrid heightInPixels={240} />
</section>

<style lang="scss">
	@use "abstracts" as *;

	// Campo de estrellas generado con gradientes radiales repetidos.
	$starfield:
		radial-gradient(
			1px 1px at 20px 30px,
			color-token("text") 50%,
			transparent 51%
		),
		radial-gradient(
			1px 1px at 140px 90px,
			color-alpha("text", 0.7) 50%,
			transparent 51%
		),
		radial-gradient(
			1.5px 1.5px at 90px 160px,
			color-token("salmon") 50%,
			transparent 51%
		),
		radial-gradient(
			1px 1px at 210px 210px,
			color-alpha("text", 0.6) 50%,
			transparent 51%
		),
		radial-gradient(
			1.5px 1.5px at 260px 60px,
			color-token("teal") 50%,
			transparent 51%
		);

	.c-hero {
		@include page-gutter;

		position: relative;
		overflow: hidden;
		background: $starfield, $gradient-sky;
		background-size:
			300px 260px,
			300px 260px,
			300px 260px,
			300px 260px,
			300px 260px,
			100% 100%;

		&__inner {
			@include flex-column;
			@include page-container;

			position: relative;
			z-index: z-layer("content");
			min-height: 940px;

			@include respond-below("laptop") {
				min-height: auto;
			}
		}

		&__presentation {
			@include flex-row(64px);

			flex: 1;
			padding-block: 64px;

			@include respond-below("laptop") {
				flex-direction: column;
				align-items: stretch;
			}
		}

		&__message {
			@include flex-column(24px, flex-start);

			flex: 1;
			min-width: 0;
		}

		&__availability {
			@include flex-row(12px);
			@include mono-label(12px, "teal", $font-weight-medium);
		}

		&__headline {
			@include flex-column(8px);
		}

		&__context {
			@include mono-label(12px, "magenta");
		}

		&__name {
			@include retro-heading(72px, $font-weight-black, 1);
			@include gradient-text(
				linear-gradient(
					180deg,
					color-token("text") 0%,
					color-token("salmon") 45%,
					color-token("magenta") 100%
				)
			);

			filter: drop-shadow(0 0 14px color-alpha("magenta", 0.6));

			@include respond-below("mobile") {
				font-size: 40px;
			}
		}

		&__role {
			@include typography("display", 46px, $font-weight-regular, 1.08);

			color: color-token("text-muted");

			@include respond-below("mobile") {
				font-size: 30px;
			}
		}

		&__role-accent {
			@include neon-text("teal");

			color: color-token("teal");
		}

		&__value {
			@include typography("body", 18px, $font-weight-regular, 1.65);

			max-width: 610px;
			color: color-token("text-muted");

			@include respond-below("mobile") {
				font-size: 16px;
			}
		}

		&__actions {
			@include flex-row(16px);

			flex-wrap: wrap;
		}

		&__links {
			@include flex-row(24px);

			flex-wrap: wrap;
			padding-top: 12px;
		}

		&__link {
			@include typography("mono", 12px);

			color: color-token("text-subtle");
			transition: color $transition-base;

			&:hover {
				color: color-token("teal");
			}
		}

		&__visual {
			flex-shrink: 0;
			width: 480px;

			@include respond-below("laptop") {
				width: 100%;
				max-width: 440px;
				margin-inline: auto;
			}
		}
	}
</style>
