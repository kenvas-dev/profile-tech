---
import type { NavigationLink } from "@domain/entities/contact";
import type { Hero, Identity } from "@domain/entities/identity";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import RetroSun from "../ui/RetroSun.astro";
import StatusDot from "../ui/StatusDot.astro";
import SynthGrid from "../ui/SynthGrid.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
	identity: Identity;
	navigation: readonly NavigationLink[];
	hero: Hero;
}

const { identity, navigation, hero } = Astro.props;
const { portrait } = hero;
---

<section class="c-hero" id="inicio" aria-labelledby="hero-title">
	<div class="c-hero__inner">
		<SiteHeader identity={identity} navigation={navigation} />

		<div class="c-hero__presentation">
			<div class="c-hero__message">
				<p class="c-hero__availability">
					<StatusDot glow />
					{hero.availability}
				</p>

				<div class="c-hero__headline">
					<p class="c-hero__context">{hero.context}</p>
					<h1 class="c-hero__name" id="hero-title">
						{identity.fullName.toUpperCase()}
					</h1>
					<p class="c-hero__role">
						{hero.role.primary}{" "}
						<span class="c-hero__role-accent">+</span>{" "}
						{hero.role.secondary}
					</p>
				</div>

				<p class="c-hero__value">{hero.valueProposition}</p>

				<div class="c-hero__actions">
					<Button
						href={hero.primaryAction.href}
						icon="arrow-down-right"
					>
						{hero.primaryAction.label}
					</Button>
					<Button
						href={hero.secondaryAction.href}
						variant="ghost"
						icon="send"
					>
						{hero.secondaryAction.label}
					</Button>
				</div>

				<ul class="c-hero__links">
					{hero.professionalLinks.map((link) => (
						<li>
							<a class="c-hero__link" href={link.href}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div class="c-hero__visual">
				<div class="c-hero__sun">
					<RetroSun size={540} />
				</div>
				<figure class="c-portrait">
					<img
						class="c-portrait__photo"
						src={portrait.image.src}
						alt={portrait.image.alt}
						width="480"
						height="610"
						fetchpriority="high"
					/>
					<span class="c-portrait__frame" aria-hidden="true"></span>
					<span class="c-portrait__code">
						<Icon name="scan-line" size={14} />
						{portrait.code}
					</span>
					<figcaption class="c-portrait__data">
						<span class="c-portrait__location">
							<span class="c-portrait__location-label">
								{portrait.baseLabel}
							</span>
							<span class="c-portrait__location-value">
								{portrait.location}
							</span>
						</span>
						<span class="c-portrait__coordinates">
							{portrait.coordinates}
						</span>
					</figcaption>
				</figure>
			</div>
		</div>
	</div>

	<SynthGrid height={240} />
</section>

<style lang="scss">
	@use "abstracts" as *;

	// Campo de estrellas generado con gradientes radiales repetidos.
	$starfield:
		radial-gradient(
			1px 1px at 20px 30px,
			color("text") 50%,
			transparent 51%
		),
		radial-gradient(
			1px 1px at 140px 90px,
			color-alpha("text", 0.7) 50%,
			transparent 51%
		),
		radial-gradient(
			1.5px 1.5px at 90px 160px,
			color("salmon") 50%,
			transparent 51%
		),
		radial-gradient(
			1px 1px at 210px 210px,
			color-alpha("text", 0.6) 50%,
			transparent 51%
		),
		radial-gradient(
			1.5px 1.5px at 260px 60px,
			color("teal") 50%,
			transparent 51%
		);

	.c-hero {
		position: relative;
		overflow: hidden;
		padding-inline: gutter("desktop");
		background: $starfield, $gradient-sky;
		background-size:
			300px 260px,
			300px 260px,
			300px 260px,
			300px 260px,
			300px 260px,
			100% 100%;

		@include respond-below("laptop") {
			padding-inline: gutter("tablet");
		}

		@include respond-below("mobile") {
			padding-inline: gutter("mobile");
		}

		&__inner {
			@include stack;

			position: relative;
			z-index: z("content");
			max-width: $container-max-width;
			min-height: 940px;
			margin-inline: auto;

			@include respond-below("laptop") {
				min-height: auto;
			}
		}

		&__presentation {
			@include cluster(64px);

			flex: 1;
			padding-block: 64px;

			@include respond-below("laptop") {
				flex-direction: column;
				align-items: stretch;
			}
		}

		&__message {
			@include stack(24px, flex-start);

			flex: 1;
			min-width: 0;
		}

		&__availability {
			@include cluster(12px);
			@include mono-label(12px, "teal", $font-weight-medium);
		}

		&__headline {
			@include stack(8px);
		}

		&__context {
			@include mono-label(12px, "magenta");
		}

		&__name {
			@include retro-heading(72px, $font-weight-black, 1);
			@include gradient-text(
				linear-gradient(
					180deg,
					color("text") 0%,
					color("salmon") 45%,
					color("magenta") 100%
				)
			);

			filter: drop-shadow(0 0 14px color-alpha("magenta", 0.6));

			@include respond-below("mobile") {
				font-size: 40px;
			}
		}

		&__role {
			@include typography("display", 46px, $font-weight-regular, 1.08);

			color: color("text-muted");

			@include respond-below("mobile") {
				font-size: 30px;
			}
		}

		&__role-accent {
			@include neon-text("teal");

			color: color("teal");
		}

		&__value {
			@include typography("body", 18px, $font-weight-regular, 1.65);

			max-width: 610px;
			color: color("text-muted");

			@include respond-below("mobile") {
				font-size: 16px;
			}
		}

		&__actions {
			@include cluster(16px);

			flex-wrap: wrap;
		}

		&__links {
			@include cluster(24px);

			flex-wrap: wrap;
			padding-top: 12px;
		}

		&__link {
			@include typography("mono", 12px);

			color: color("text-subtle");
			transition: color $transition-base;

			&:hover {
				color: color("teal");
			}
		}

		&__visual {
			position: relative;
			flex-shrink: 0;

			@include respond-below("laptop") {
				width: 100%;
				max-width: 480px;
			}
		}

		&__sun {
			position: absolute;
			top: -150px;
			left: 50%;
			transform: translateX(-50%);

			@include respond-below("mobile") {
				top: -90px;
				scale: 0.7;
			}
		}
	}

	.c-portrait {
		position: relative;
		flex-shrink: 0;
		width: 480px;
		height: 610px;
		border-radius: $radius-lg;
		overflow: hidden;
		filter: drop-shadow(0 0 28px color-alpha("magenta", 0.45));

		@include respond-below("laptop") {
			width: 100%;
			max-width: 480px;
			height: auto;
			aspect-ratio: 480 / 610;
		}

		&::before {
			@include synthwave-tint;

			z-index: z("content");
		}

		&::after {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(
				to bottom,
				color-alpha("background", 0) 25%,
				color-alpha("background", 0.8)
			);
			pointer-events: none;
		}

		&__photo {
			@include cover-image;
		}

		&__frame {
			@include neon-box("teal", 0.7);

			position: absolute;
			inset: 18px;
			z-index: z("content");
			border: 1px solid color("teal");
			border-radius: $radius-md;
		}

		&__code {
			@include overlay-badge;

			position: absolute;
			top: 30px;
			left: 30px;
			z-index: z("overlay");
			color: color("teal");
		}

		&__data {
			@include cluster(16px, flex-end, space-between);

			position: absolute;
			right: 30px;
			bottom: 30px;
			left: 30px;
			z-index: z("overlay");
		}

		&__location {
			@include stack(4px);
		}

		&__location-label {
			@include typography("mono", 10px);

			color: color("text-subtle");
		}

		&__location-value {
			@include typography("body", 14px, $font-weight-semibold);

			color: color("text");
		}

		&__coordinates {
			@include typography("mono", 10px);

			color: color("salmon");
		}
	}
</style>
