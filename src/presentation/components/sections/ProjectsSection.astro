---
/**
 * Sección de proyectos: proyecto destacado y rejilla con el resto.
 */
import type { PortfolioOverview } from "@application/use-cases/GetPortfolio";
import FeaturedProjectCard from "../projects/FeaturedProjectCard.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	/** Índice visible de la sección. */
	sectionIndex: string;
	/** Proyectos separados en destacado y resto. */
	projects: PortfolioOverview["projects"];
}

const { sectionIndex, projects } = Astro.props;
---

<section class="l-section" id="proyectos" aria-labelledby="proyectos-title">
	<div class="l-container">
		<SectionHeader
			sectionIndex={sectionIndex}
			intro={projects.intro}
			headingId="proyectos-title"
		/>

		<FeaturedProjectCard project={projects.featuredProject} />

		<ul class="c-projects-grid">
			{projects.otherProjects.map((project) => (
				<li>
					<ProjectCard project={project} />
				</li>
			))}
		</ul>
	</div>
</section>

<style lang="scss">
	@use "abstracts" as *;

	.c-projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;

		@include respond-below("tablet") {
			grid-template-columns: 1fr;
		}
	}
</style>
