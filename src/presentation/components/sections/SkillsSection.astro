---
/**
 * Sección de stack: grupos de tecnologías y panel de fortalezas.
 */
import type { Skills } from "@domain/entities/skills";
import { getUiTranslationsFor } from "../../i18n/ui";
import Icon from "../ui/Icon.astro";
import PillList from "../ui/PillList.astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	/** Índice visible de la sección. */
	sectionIndex: string;
	/** Contenido del stack. */
	skills: Skills;
}

const { sectionIndex, skills } = Astro.props;
const uiText = getUiTranslationsFor(Astro.currentLocale);
const { strengths } = skills;
---

<section class="l-section" id="stack" aria-labelledby="stack-title">
	<div class="l-container">
		<SectionHeader
			sectionIndex={sectionIndex}
			intro={skills.intro}
			headingId="stack-title"
		/>

		<div class="c-skills">
			<ul class="c-skills__groups">
				{skills.skillGroups.map((group) => (
					<li class="c-skill-group">
						<span class="c-skill-group__code">
							{group.sequenceCode}
						</span>
						<div class="c-skill-group__definition">
							<h3 class="c-skill-group__title">{group.title}</h3>
							<p class="c-skill-group__description">
								{group.description}
							</p>
						</div>
						<div class="c-skill-group__technologies">
							<PillList items={group.technologies} />
						</div>
					</li>
				))}
			</ul>

			<aside class="c-strengths" aria-label={uiText.strengthsPanelLabel}>
				<header class="c-strengths__header">
					<span class="c-strengths__label">
						{strengths.sectionLabel}
					</span>
					<span class="c-strengths__version">
						{strengths.versionTag}
					</span>
				</header>

				<ul class="c-strengths__list">
					{strengths.items.map((strength) => (
						<li class="c-strength">
							<span class="c-strength__icon">
								<Icon
									iconName={strength.iconName}
									size={20}
									strokeWidth={1.6}
								/>
							</span>
							<h3 class="c-strength__title">{strength.title}</h3>
							<p class="c-strength__description">
								{strength.description}
							</p>
						</li>
					))}
				</ul>
			</aside>
		</div>
	</div>
</section>

<style lang="scss">
	@use "abstracts" as *;

	// Proporciones en lugar de anchos fijos: a 1280px reproduce el diseño
	// (850px + 382px) y en pantallas intermedias las fortalezas no se estrechan.
	.c-skills {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(300px, 30%);
		gap: 48px;
		align-items: start;

		@include respond-below("laptop") {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.c-skill-group {
		@include flex-row(32px, flex-start);
		@include divider(bottom);

		min-height: 136px;
		padding-block: 24px;

		@include respond-below("tablet") {
			flex-wrap: wrap;
			gap: 16px 32px;
		}

		&__code {
			@include typography("mono", 12px);
			@include neon-text("magenta", 0.5);

			flex-shrink: 0;
			width: 54px;
			color: color-token("magenta");
		}

		&__definition {
			@include flex-column(8px);

			flex-shrink: 0;
			width: 285px;

			@include respond-below("mobile") {
				width: 100%;
			}
		}

		&__title {
			@include typography("display", 28px);

			color: color-token("text");
		}

		&__description {
			@include typography("body", 14px, $font-weight-regular, 1.55);

			color: color-token("text-muted");
		}

		&__technologies {
			flex: 1;
			min-width: 0;
			padding-top: 4px;

			@include respond-below("tablet") {
				flex-basis: 100%;
			}
		}
	}

	.c-strengths {
		@include surface($border: "magenta");
		@include flex-column(32px);
		@include neon-box("magenta", 0.5);

		background:
			linear-gradient(180deg, color-alpha("plum", 0.25), transparent 60%),
			color-token("surface");
		min-height: 408px;
		padding: 32px;

		@include respond-below("laptop") {
			min-height: 0;
		}

		@include respond-below("mobile") {
			padding: 24px;
		}

		&__header {
			@include flex-row(16px, center, space-between);
		}

		&__label {
			@include typography("mono", 12px);

			color: color-token("salmon");
		}

		&__version {
			@include typography("mono", 10px);

			color: color-token("text-subtle");
		}

		&__list {
			@include flex-column(32px);

			// A todo el ancho, las fortalezas se reparten en columnas.
			@include respond-below("laptop") {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 32px;
			}
		}
	}

	.c-strength {
		@include flex-column(12px, flex-start);

		&__icon {
			color: color-token("teal");
			filter: drop-shadow(0 0 6px color-alpha("teal", 0.8));
		}

		&__title {
			@include typography("display", 20px, $font-weight-bold);

			color: color-token("text");
		}

		&__description {
			@include typography("body", 14px, $font-weight-regular, 1.55);

			color: color-token("text-muted");
		}
	}
</style>
