---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { NavigationLink } from "@domain/entities/contact";
import type { Identity } from "@domain/entities/identity";
import { LOCALES } from "@domain/entities/locale";
import { resolveLocale, useTranslations } from "../../i18n/ui";
import Monogram from "../ui/Monogram.astro";

interface Props {
	identity: Identity;
	navigation: readonly NavigationLink[];
}

const { identity, navigation } = Astro.props;
const currentLocale = resolveLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<header class="c-site-header">
	<Monogram mark={identity.logo} name={identity.handle} href="#inicio" />

	<nav class="c-site-header__nav" aria-label={t.mainNavigation}>
		<ul class="c-site-header__links">
			{navigation.map((link) => (
				<li>
					<a class="c-site-header__link" href={link.href}>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<nav class="c-site-header__languages" aria-label={t.languageSwitcher}>
		{LOCALES.map((locale, index) => (
			<>
				{index > 0 && (
					<span class="c-site-header__separator" aria-hidden="true">
						/
					</span>
				)}
				{locale === currentLocale ? (
					<span
						class="c-site-header__language c-site-header__language--active"
						aria-current="page"
						title={t.languageNames[locale]}
					>
						{locale.toUpperCase()}
					</span>
				) : (
					<a
						class="c-site-header__language"
						href={getRelativeLocaleUrl(locale)}
						hreflang={locale}
						lang={locale}
						title={t.languageNames[locale]}
					>
						{locale.toUpperCase()}
					</a>
				)}
			</>
		))}
	</nav>
</header>

<style lang="scss">
	@use "abstracts" as *;

	.c-site-header {
		@include cluster(24px, center, space-between);

		height: 88px;
		border-bottom: 1px solid color-alpha("magenta", 0.4);

		&__links {
			@include cluster(32px);

			@include respond-below("laptop") {
				display: none;
			}
		}

		&__link {
			@include typography("body", 14px, $font-weight-medium);

			color: color("text-muted");
			transition: color $transition-base;

			&:hover {
				@include neon-text("teal", 0.6);

				color: color("teal");
			}
		}

		&__languages {
			@include cluster(8px);
		}

		&__separator {
			@include typography("mono", 12px);

			color: color("text-subtle");
		}

		&__language {
			@include typography("mono", 12px);

			padding: 4px 2px;
			color: color("text-subtle");
			transition: color $transition-base;

			&:hover {
				color: color("text");
			}

			&--active {
				@include neon-text("teal", 0.5);

				color: color("teal");
			}
		}
	}
</style>
