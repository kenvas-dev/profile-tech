---
/**
 * Barra superior: logo, navegación por secciones y selector de idioma.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import type { NavigationLink } from "@domain/entities/contact";
import type { Identity } from "@domain/entities/identity";
import { LOCALES } from "@domain/entities/locale";
import { getUiTranslations, resolveLocale } from "../../i18n/ui";
import Monogram from "../ui/Monogram.astro";

interface Props {
	/** Datos de la persona (logo y alias). */
	identity: Identity;
	/** Enlaces a las secciones. */
	navigation: readonly NavigationLink[];
}

const { identity, navigation } = Astro.props;
const currentLocale = resolveLocale(Astro.currentLocale);
const uiText = getUiTranslations(currentLocale);
---

<header class="c-site-header">
	<Monogram
		brandMark={identity.brandMark}
		displayName={identity.username}
		href="#inicio"
	/>

	<nav class="c-site-header__nav" aria-label={uiText.mainNavigationLabel}>
		<ul class="c-site-header__links">
			{navigation.map((link) => (
				<li>
					<a class="c-site-header__link" href={link.href}>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<nav
		class="c-site-header__languages"
		aria-label={uiText.languageSwitcherLabel}
	>
		{LOCALES.map((locale, index) => (
			<>
				{index > 0 && (
					<span class="c-site-header__separator" aria-hidden="true">
						/
					</span>
				)}
				{locale === currentLocale ? (
					<span
						class="c-site-header__language c-site-header__language--active"
						aria-current="page"
						title={uiText.languageNames[locale]}
					>
						{locale.toUpperCase()}
					</span>
				) : (
					<a
						class="c-site-header__language"
						href={getRelativeLocaleUrl(locale)}
						hreflang={locale}
						lang={locale}
						title={uiText.languageNames[locale]}
					>
						{locale.toUpperCase()}
					</a>
				)}
			</>
		))}
	</nav>
</header>

<style lang="scss">
	@use "abstracts" as *;

	.c-site-header {
		@include flex-row(24px, center, space-between);

		height: 88px;
		border-bottom: 1px solid color-alpha("magenta", 0.4);

		&__links {
			@include flex-row(32px);

			@include respond-below("laptop") {
				display: none;
			}
		}

		&__link {
			@include typography("body", 14px, $font-weight-medium);

			color: color-token("text-muted");
			transition: color $transition-base;

			&:hover {
				@include neon-text("teal", 0.6);

				color: color-token("teal");
			}
		}

		&__languages {
			@include flex-row(8px);
		}

		&__separator {
			@include typography("mono", 12px);

			color: color-token("text-subtle");
		}

		&__language {
			@include typography("mono", 12px);

			padding: 4px 2px;
			color: color-token("text-subtle");
			transition: color $transition-base;

			&:hover {
				color: color-token("text");
			}

			&--active {
				@include neon-text("teal", 0.5);

				color: color-token("teal");
			}
		}
	}
</style>
