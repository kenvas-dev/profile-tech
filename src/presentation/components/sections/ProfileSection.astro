---
/**
 * Sección de perfil: titular, biografía, especialización y métricas.
 */
import type { Profile } from "@domain/entities/profile";
import SectionLabel from "../ui/SectionLabel.astro";

interface Props {
	/** Índice visible de la sección (p. ej. `/01`). */
	sectionIndex: string;
	/** Contenido del perfil. */
	profile: Profile;
}

const { sectionIndex, profile } = Astro.props;
---

<section
	class="l-section l-section--alt l-section--compact"
	id="perfil"
	aria-labelledby="perfil-title"
>
	<div class="l-container c-profile">
		<div class="c-profile__divider" aria-hidden="true"></div>

		<div class="c-profile__content">
			<div class="c-profile__intro">
				<SectionLabel
					sectionIndex={sectionIndex}
					sectionLabel={profile.sectionLabel}
				/>
				<h2 class="c-profile__title" id="perfil-title">
					{profile.title}
				</h2>
			</div>

			<div class="c-profile__summary">
				<p class="c-profile__biography">{profile.biography}</p>
				<p class="c-profile__focus">{profile.specialization}</p>

				<dl class="c-profile__metrics">
					{profile.metrics.map((metric) => (
						<div class="c-profile__metric">
							<dt class="c-profile__metric-label">
								{metric.label}
							</dt>
							<dd class="c-profile__metric-value">
								{metric.value}
							</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use "abstracts" as *;

	.c-profile {
		&__content {
			@include flex-row(64px, flex-start);

			@include respond-below("laptop") {
				flex-direction: column;
				gap: 40px;
			}
		}

		&__divider {
			height: 2px;
			background: linear-gradient(
				to right,
				color-token("magenta") 0 120px,
				color-token("border") 120px
			);
			box-shadow: 0 0 12px color-alpha("magenta", 0.5);
		}

		&__intro {
			@include flex-column(24px);

			flex-shrink: 0;
			width: 380px;

			@include respond-below("laptop") {
				width: auto;
			}
		}

		&__title {
			@include typography("retro", 38px, $font-weight-bold, 1.18);
			@include neon-text("magenta", 0.6);

			color: color-token("text");

			@include respond-below("laptop") {
				font-size: 30px;
			}
		}

		&__summary {
			@include flex-column(32px);

			flex: 1;
			min-width: 0;
		}

		&__biography {
			@include typography("body", 24px, $font-weight-regular, 1.5);

			color: color-token("text");

			@include respond-below("mobile") {
				font-size: 19px;
			}
		}

		&__focus {
			@include typography("body", 16px, $font-weight-regular, 1.7);
			@include divider(bottom);

			max-width: 760px;
			padding-bottom: 32px;
			color: color-token("text-muted");
		}

		&__metrics {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 32px;

			@include respond-below("mobile") {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		&__metric {
			@include flex-column(8px);

			flex-direction: column-reverse;
		}

		&__metric-value {
			@include typography("retro", 36px, $font-weight-bold);
			@include neon-text("teal", 0.7);

			color: color-token("teal");
			white-space: nowrap;

			@include respond-below("mobile") {
				font-size: 32px;
			}
		}

		&__metric-label {
			@include mono-label(12px);

			line-height: 1.45;
		}
	}
</style>
