---
/**
 * Pie de página con logo, nota técnica y copyright.
 */
import type { Footer } from "@domain/entities/contact";
import type { Identity } from "@domain/entities/identity";
import Monogram from "../ui/Monogram.astro";

interface Props {
	/** Datos de la persona. */
	identity: Identity;
	/** Textos del pie. */
	footer: Footer;
}

const { identity, footer } = Astro.props;
---

<footer class="c-site-footer">
	<div class="c-site-footer__inner">
		<Monogram
			brandMark={identity.brandMark}
			displayName={identity.fullName}
			size="sm"
		/>
		<p class="c-site-footer__note">{footer.builtWithNote}</p>
		<p class="c-site-footer__copyright">{footer.copyrightNotice}</p>
	</div>
</footer>

<style lang="scss">
	@use "abstracts" as *;

	.c-site-footer {
		@include page-gutter;

		border-top: 1px solid color-alpha("magenta", 0.5);
		box-shadow: 0 -1px 14px color-alpha("magenta", 0.35);
		background: color-token("background-alt");

		&__inner {
			@include flex-row(24px, center, space-between);
			@include page-container;

			min-height: 150px;

			@include respond-below("tablet") {
				flex-direction: column;
				align-items: flex-start;
				justify-content: center;
				padding-block: 40px;
			}
		}

		&__note {
			@include typography("mono", 10px);

			color: color-token("text-subtle");
		}

		&__copyright {
			@include typography("body", 12px);

			color: color-token("text-subtle");
		}
	}
</style>
