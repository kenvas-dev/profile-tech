---
/**
 * Metadatos SEO de una página: título, descripción, canónica, `hreflang`, Open Graph, Twitter Card y datos estructurados JSON-LD. Requiere `site` en `astro.config.mjs`.
 */
import { getAbsoluteLocaleUrl } from "astro:i18n";
import type { PortfolioOverview } from "@application/use-cases/GetPortfolio";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@domain/entities/locale";
import { buildStructuredData } from "../../seo/structuredData";

interface Props {
	/** Idioma de la página. */
	locale: Locale;
	/** Contenido del que se derivan los metadatos. */
	portfolio: PortfolioOverview;
}

const { locale, portfolio } = Astro.props;
const { seo, identity } = portfolio;

/** Variante regional de cada idioma (hreflang, og:locale, sitemap). */
const REGIONAL_LOCALES: Record<Locale, { tag: string; og: string }> = {
	es: { tag: "es-SV", og: "es_SV" },
	en: { tag: "en-US", og: "en_US" },
};

if (!Astro.site) {
	throw new Error(
		"Define `site` en astro.config.mjs para generar URLs absolutas.",
	);
}

const site = Astro.site;
const canonical = new URL(getAbsoluteLocaleUrl(locale));
const socialImage = new URL(seo.socialImage.src, site).href;
const alternates = LOCALES.map((alternate) => ({
	hreflang: REGIONAL_LOCALES[alternate].tag,
	href: getAbsoluteLocaleUrl(alternate),
}));

const structuredData = buildStructuredData(portfolio, {
	site,
	page: canonical,
	language: REGIONAL_LOCALES[locale].tag,
	languages: LOCALES.map((code) => REGIONAL_LOCALES[code].tag),
});
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="keywords" content={seo.keywords.join(", ")} />
<meta name="author" content={identity.fullName} />
<meta
	name="robots"
	content="index, follow, max-image-preview:large, max-snippet:-1"
/>
<link rel="canonical" href={canonical.href} />

{alternates.map(({ hreflang, href }) => (
	<link rel="alternate" hreflang={hreflang} href={href} />
))}
<link
	rel="alternate"
	hreflang="x-default"
	href={getAbsoluteLocaleUrl(DEFAULT_LOCALE)}
/>

<!-- Open Graph (LinkedIn, WhatsApp, Facebook, Slack…) -->
<meta property="og:type" content="profile" />
<meta property="og:site_name" content={`${identity.fullName} — Portfolio`} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={REGIONAL_LOCALES[locale].og} />
{LOCALES.filter((code) => code !== locale).map((code) => (
	<meta property="og:locale:alternate" content={REGIONAL_LOCALES[code].og} />
))}
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.socialImage.alt} />
<meta property="profile:first_name" content={identity.fullName.split(" ")[0]} />
<meta
	property="profile:last_name"
	content={identity.fullName.split(" ").slice(1).join(" ")}
/>
<meta property="profile:username" content={identity.username} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={seo.socialImage.alt} />

<!-- Datos estructurados (schema.org) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
